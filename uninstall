#!/bin/bash
# Stop and remove Met Wallpaper's systemd --user timers and CLI symlinks.
# Cached images under ~/.local/state/omarchy-met-wallpaper are left in place.
set -uo pipefail

UNITS_DIR="$HOME/.config/systemd/user"
BIN_DIR="$HOME/.local/bin"

for name in omarchy-met-wallpaper-plan.timer omarchy-met-wallpaper-retry.timer \
            omarchy-met-wallpaper-rotate.timer; do
  systemctl --user disable --now "$name" >/dev/null 2>&1
done

for name in omarchy-met-wallpaper-plan.timer omarchy-met-wallpaper-plan.service \
            omarchy-met-wallpaper-retry.timer \
            omarchy-met-wallpaper-rotate.timer omarchy-met-wallpaper-rotate.service; do
  target="$UNITS_DIR/$name"
  [[ -L $target ]] && rm -f "$target"
done

for name in omarchy-met-wallpaper-plan omarchy-met-wallpaper-rotate omarchy-met-wallpaper-status \
  omarchy-met-wallpaper-skip omarchy-met-wallpaper-toggle-pause; do
  target="$BIN_DIR/$name"
  [[ -L $target ]] && rm -f "$target"
done

systemctl --user daemon-reload

echo "Timers and symlinks removed."
echo "Cached images remain in ~/.local/state/omarchy-met-wallpaper"
echo "  rm -rf ~/.local/state/omarchy-met-wallpaper   # to delete them"
echo "Then: omarchy plugin remove pixel-jack.met-wallpaper"
